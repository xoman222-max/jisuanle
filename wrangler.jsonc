// Cloudflare Workers（靜態資產＋API）設定。Workers Builds 預設以 `npx wrangler deploy` 部署。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jisuanle",
  "main": "worker/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // 意見回饋寄到這個信箱（需在 jisuanle.com 啟用 Email Routing 並驗證此目的地地址）
  "send_email": [{ "name": "FEEDBACK_EMAIL", "destination_address": "ai2chuio@mail.grokbot.com" }],
  // 每個 IP 每 60 秒最多 5 次回饋
  "ratelimits": [
    { "name": "FEEDBACK_RL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "AI_RL", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    // 章節留言：每 IP 每 60 秒最多 2 則（另有 CommentGate DO 的 30 秒冷卻）
    { "name": "COMMENT_RL", "namespace_id": "1003", "simple": { "limit": 2, "period": 60 } }
  ],
  // Workers AI（看圖配梗）：部署時自動綁定，免費額度 10,000 neurons/天
  // 小說章節留言（key = "c:<book>/<chapter>"，值為 JSON 陣列）
  "kv_namespaces": [{ "binding": "NOVEL_COMMENTS", "id": "b1928ac7655a42819507652186f8a193" }],
  "ai": { "binding": "AI" },
  // 瀏覽計數：SQLite Durable Object（部署時自動建立，免費方案可用）
  "durable_objects": { "bindings": [{ "name": "STATS", "class_name": "Stats" }, { "name": "COMMENT_GATE", "class_name": "CommentGate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stats"] }, { "tag": "v2", "new_sqlite_classes": ["CommentGate"] }],
  "vars": {
    // 改成 "true" 才會在頁尾公開顯示「今日瀏覽 · 總瀏覽」
    "SHOW_COUNTER": "false",
    "AI_DAILY_CAP": "500",
    "TRANSLATE_DAILY_CAP": "300"
  },
  "observability": { "enabled": true }
}
